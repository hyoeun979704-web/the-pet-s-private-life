rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player saves: owner read-only, no client writes.
    // All mutations go through Cloud Functions (addResources,
    // consumeFatigue, rollGacha).
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public read-only content (announcements, seasons, shop catalogs).
    match /public/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
